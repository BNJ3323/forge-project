  m_Script: {fileID: 11500000, guid: 5d2775530d7472548b85d4773c3359ce, type: 3}
  m_Name: Dialogue_VieilHomme
  m_EditorClassIdentifier: Forge.Runtime::Forge.Runtime.DialogueData
  npcName: Vieil homme
  startNodeId: start
  nodes:
  - id: start
    speaker: Vieil homme
    text: "Je garde cette porte depuis des ann\xE9es. Elle ne s'ouvre qu'avec la bonne cl\xE9."
    choices:
    - text: "Je cherche la cl\xE9."
      nextNodeId: key
      condition: 
      consequence: 
    - text: "J'ai la cl\xE9 du ma\xEEtre."
      nextNodeId: open
      condition: has:Item_CleDuMaitre
      consequence: flag:door_open
  - id: key
    speaker: Vieil homme
    text: Un boss la porte sur lui, je crois. Bonne chance.
    choices:
    - text: Merci.
      nextNodeId: bye
      condition: 
      consequence: 
  - id: open
    speaker: Vieil homme
    text: Ah ! Passez, passez, brave aventurier.
    choices: []
  - id: bye
    speaker: Vieil homme
    text: Prenez garde.
    choices: []
