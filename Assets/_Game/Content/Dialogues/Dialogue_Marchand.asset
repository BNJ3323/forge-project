  npcName: Marchand
  startNodeId: start
  nodes:
  - id: start
    speaker: Marchand
    text: Psst, voyageur ! Besoin de provisions avant de descendre ?
    choices:
    - text: Que vendez-vous ?
      nextNodeId: shop
      condition: 
      consequence: 
    - text: Des rumeurs sur le donjon ?
      nextNodeId: rumor
      condition: 
      consequence: 
    - text: Non merci.
      nextNodeId: bye
      condition: 
      consequence: 
  - id: shop
    speaker: Marchand
    text: "Potions, pain, torches\u2026 Tout ce qu'il faut pour survivre."
    choices:
    - text: Acheter une potion
      nextNodeId: thanks
      condition: gold>=8
      consequence: give:Item_PotionDeSoinMineure
    - text: Retour
      nextNodeId: start
      condition: 
      consequence: 
  - id: rumor
    speaker: Marchand
    text: "On dit qu'un roi des rats r\xE8gne au premier \xE9tage. M\xE9fiez-vous."
    choices:
    - text: Merci du conseil.
      nextNodeId: bye
      condition: 
      consequence: 
  - id: thanks
    speaker: Marchand
    text: Bonne affaire ! Revenez me voir.
    choices: []
  - id: bye
    speaker: Marchand
    text: Que la chance vous accompagne.
    choices: []
